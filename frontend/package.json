        "vue": "^3.5.44",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@tailwindcss/forms": "^0.5.10",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "autoprefixer": "^10.6.2",
        "postcss": "^8.5.32",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.14"
    },
    "packageManager": "pnpm@10.28.2"
