# ============================================================================
# 服务端基础配置
# ============================================================================
# 监听地址
HOST=127.0.0.1
# 监听端口
PORT=5519
# API 前缀
API_PREFIX=/api
# Bestdori API 地址
BESTDORI_API=https://bestdori.com/api/
# Bestdori 最低更新时间（秒），小于此值复用缓存
MIN_POINTS_UPDATE_TIME=45
# Bestdori 请求超时（毫秒）
BESTDORI_TIMEOUT_MS=10000
# Bestdori 歌曲检查间隔（毫秒）
BESTDORI_SONGS_CHECK_INTERVAL_MS=86400000
# 是否存储 Bestdori 原始谱面数据
BESTDORI_STORE_RAW_CHARTS=false
# 是否启用 CORS
ENABLE_CORS=false
# 是否启用前端代理
APP_PROXY=false

# ============================================================================
# Garupa 游戏服务器配置
# （4 值逗号分隔：[日服, 国际服, 台服, 国服]）
# 不配置的服填 "-" 占位
# ============================================================================
# 游戏 API 基础地址
GARUPA_SERVER_BASES=-,-,-,-
# 用于爬取排名的玩家 UID（国服已经由登录流程自动处理，此处国服配置无效）
GARUPA_UIDS=-,-,-,-
# X-Signature（客户端 UUID）（国服已经由登录流程自动处理，此处国服配置无效）
GARUPA_UUIDS=-,-,-,-
# AES-128-CBC 加密密钥（16 字节）
GARUPA_ENCRYPTION_KEYS=-,-,-,-
# AES-128-CBC 初始化向量（16 字节）
GARUPA_ENCRYPTION_IVS=-,-,-,-
# 客户端版本号
GARUPA_CLIENT_VERSIONS=-,-,-,-
# 渠道 ID
GARUPA_CIDS=-,-,-,1
# 平台 ID
GARUPA_PIDS=-,-,-,2
# 客户端平台
GARUPA_CLIENT_PLATFORMS=Android,-,-,Android
# RID 签名密钥
GARUPA_RKEYS=-,-,-,-
# ============================================================================
# 国服帐号密码登录
# ============================================================================
# B 站 SDK 登录签名密钥
GARUPA_CN_SDK_APP_KEY=
# B 站 SDK 登录帐号
GARUPA_CN_ACCOUNT=
# B 站 SDK 登录帐号的密码，用于生成 RSA 加密的登录参数
GARUPA_CN_PASSWORD=
# B 站 SDK 登录服务的 HTTPS 基础地址，用于获取 RSA 公钥和提交帐号密码登录请求
GARUPA_CN_SDK_BASE=
# 游戏客户端设备标识；(实际是Settings.Secure.ANDROID_ID的MD5，但是随便填一个32位16进制都行)
GARUPA_CN_DEVICE_ID=
# B 站 SDK BUVID；留空时按 Android ID 分支由 GARUPA_CN_DEVICE_ID 生成
GARUPA_CN_BUVID=
# SDK 表单 udid；留空时复用最终 BUVID，填写时使用指定值
GARUPA_CN_SDK_UDID=
# SDK 设备标识；暂建议填写官方客户端成功登录请求表单中的 bd_id，可通过 HTTPS 抓包获取
# 留空时在当前客户端实例内随机生成并复用；新生成的值可能触发验证码
GARUPA_CN_BD_ID=
# 游戏登录请求中的设备品牌及型号字符串
GARUPA_CN_DEVICE_MODEL=HXY MP08
# 游戏登录请求中的 Android 系统描述字符串，包含系统版本、API 级别和构建信息
GARUPA_CN_DEVICE_OS=Android OS 12 / API-31 (SP1A.210812.016/2207251529)
# 游戏 UserUdid.adId；已分析客户端版本固定填入 12345
GARUPA_CN_AD_ID=12345
# Android 安装包的签名指纹，作为 SDK 登录请求的 apk_sign 参数
GARUPA_CN_APK_SIGN=
# B 站游戏 SDK 版本号，作为 sdk_ver 参数
GARUPA_CN_SDK_VERSION=6.19.5
# Android 安装包版本代码，作为 SDK 登录请求的 version_code 参数
GARUPA_CN_VERSION_CODE=105
# 国服登录流程中每个 HTTP 请求的超时上限（毫秒），默认 30 秒
# 覆盖登录前游戏版本信息查询、SDK 获取公钥／帐号密码登录、游戏登录
# 每个请求独立计时，包含连接和响应体读取；不包含排队等待，不是整套流程的总时限
# 榜单请求沿用 DOWNLOADER_TIMEOUT_MS；不影响 iTunes 版本查询或通用下载器请求
GARUPA_CN_LOGIN_TIMEOUT_MS=30000
# 登录或请求失败后的重试冷却时间（毫秒）
GARUPA_CN_LOGIN_RETRY_MS=300000
# ============================================================================
# MongoDB
# ============================================================================
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=garupa
MONGODB_CONNECTION_TIMEOUT_MS=60000
# ============================================================================
# 排名刷新
# ============================================================================
GARUPA_REFRESH_INTERVAL_SECONDS=60
GARUPA_REFRESH_AT_SECOND=0

# Songs use JP suite/master as primary. Configure entry 0 of GARUPA_ENCRYPTION_KEYS
# and GARUPA_ENCRYPTION_IVS. UID/UUID and MongoDB are not needed for songs.
# Bestdori only supplements missing metadata; scoreLevel always comes from JP.
