# ============================================================================
# 服务端基础配置
# ============================================================================
# 监听地址
HOST=127.0.0.1
# 监听端口
PORT=5519
# API 前缀
API_PREFIX=/api
# Bestdori API 地址
BESTDORI_API=https://bestdori.com/api/
# Bestdori 最低更新时间（秒），小于此值复用缓存
MIN_POINTS_UPDATE_TIME=45
# Bestdori 请求超时（毫秒）
BESTDORI_TIMEOUT_MS=10000
# Bestdori 歌曲检查间隔（毫秒）
BESTDORI_SONGS_CHECK_INTERVAL_MS=86400000
# 是否存储 Bestdori 原始谱面数据
BESTDORI_STORE_RAW_CHARTS=false
# 是否启用 CORS
ENABLE_CORS=false
# 是否启用前端代理
APP_PROXY=false

# ============================================================================
# Garupa 游戏服务器配置
# （4 值逗号分隔：[日服, 国际服, 台服, 国服]）
# 不配置的服填 "-" 占位
# ============================================================================
# 服务器域名
GARUPA_SERVER_BASES=-,-,-,-
# 用于爬取排名的玩家 UID
GARUPA_UIDS=-,-,-,-
# X-Signature（客户端 UUID）
GARUPA_UUIDS=-,-,-,-
# AES-128-CBC 加密密钥（16 字节）
GARUPA_ENCRYPTION_KEYS=-,-,-,-
# AES-128-CBC 初始化向量（16 字节）
GARUPA_ENCRYPTION_IVS=-,-,-,-
# 客户端版本号
GARUPA_CLIENT_VERSIONS=-,-,-,-
# ============================================================================
# 国服专用（日服/国际服/台服填 "-" 即可）
# ============================================================================
# X-ChannelID
GARUPA_CIDS=-,-,-,-
# X-PlatformID
GARUPA_PIDS=-,-,-,-
# ============================================================================
# MongoDB
# ============================================================================
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=garupa
MONGODB_CONNECTION_TIMEOUT_MS=60000
# ============================================================================
# 排名刷新
# ============================================================================
GARUPA_REFRESH_INTERVAL_SECONDS=60
GARUPA_REFRESH_AT_SECOND=0
