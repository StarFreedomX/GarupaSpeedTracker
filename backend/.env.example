# ============================================================================
# 服务端基础配置
# ============================================================================
# 监听地址
HOST=127.0.0.1
# 监听端口
PORT=5519
# API 前缀
API_PREFIX=/api
# Bestdori API 地址
BESTDORI_API=https://bestdori.com/api/
# Bestdori 最低更新时间（秒），小于此值复用缓存
MIN_POINTS_UPDATE_TIME=45
# 通用下载器请求超时（毫秒），用于 Bestdori 和游戏榜单请求
DOWNLOADER_TIMEOUT_MS=10000
# Bestdori 歌曲检查间隔（毫秒）
BESTDORI_SONGS_CHECK_INTERVAL_MS=86400000
# 是否存储 Bestdori 原始谱面数据
BESTDORI_STORE_RAW_CHARTS=false
# 是否启用 CORS
ENABLE_CORS=false
# 是否信任反向代理头
APP_PROXY=false

# ============================================================================
# Garupa 游戏服务器配置
# （4 值逗号分隔，依次为日服、国际服、台服、国服）
# 不配置的服填 "-" 占位
# ============================================================================
# 游戏 API 基础地址
GARUPA_SERVER_BASES=-,-,-,-
# 用于爬取排名的玩家 UID（国服已经由登录流程自动处理，此处国服配置无效）
GARUPA_UIDS=-,-,-,-
# X-Signature（客户端 UUID）（国服已经由登录流程自动处理，此处国服配置无效）
GARUPA_UUIDS=-,-,-,-
# AES-128-CBC 加密密钥（16 字节）
GARUPA_ENCRYPTION_KEYS=-,-,-,-
# AES-128-CBC 初始化向量（16 字节）
GARUPA_ENCRYPTION_IVS=-,-,-,-
# 客户端版本号
GARUPA_CLIENT_VERSIONS=-,-,-,-
# 渠道 ID
GARUPA_CIDS=-,-,-,1
# 平台 ID
GARUPA_PIDS=-,-,-,2
# 客户端平台
GARUPA_CLIENT_PLATFORMS=Android,-,-,Android
# [CN必填] RID 签名密钥
GARUPA_RKEYS=-,-,-,-
# ============================================================================
# 国服帐号密码登录
# ============================================================================
# [CN必填] B 站 SDK 登录签名密钥
GARUPA_CN_SDK_APP_KEY=
# [CN必填] B 站 SDK 登录帐号
GARUPA_CN_ACCOUNT=
# [CN必填] B 站 SDK 登录帐号的密码，用于生成 RSA 加密的登录参数
GARUPA_CN_PASSWORD=
# [可留空默认] B 站 SDK 登录服务的 HTTPS 基础地址，用于获取 RSA 公钥和提交帐号密码登录请求
GARUPA_CN_SDK_BASE=https://line1-sdk-center-login-sh.biligame.net
# [CN必填] 游戏客户端设备标识；BUVID 留空时须为 32 位十六进制字符串
GARUPA_CN_DEVICE_ID=
# [可留空默认] B 站 SDK BUVID；留空时由 GARUPA_CN_DEVICE_ID 生成
GARUPA_CN_BUVID=
# [可留空默认] SDK 表单 udid；留空时复用最终 BUVID，填写时使用指定值
GARUPA_CN_SDK_UDID=
# [可留空默认] SDK 设备标识；可填写官方客户端成功登录请求表单中的 bd_id
# 留空时在当前客户端实例内随机生成并复用；新生成的值可能触发验证码
GARUPA_CN_BD_ID=
# [CN必填] 游戏登录请求中的设备品牌及型号；以下为示例值，按客户端填写
GARUPA_CN_DEVICE_MODEL=HXY MP08
# [CN必填] 游戏登录请求中的 Android 系统描述；以下为示例值，按客户端填写
GARUPA_CN_DEVICE_OS=Android OS 12 / API-31 (SP1A.210812.016/2207251529)
# [CN必填] 游戏 UserUdid.adId；以下为示例值，按客户端填写
GARUPA_CN_AD_ID=12345
# [CN必填] Android 安装包的签名指纹，作为 SDK 登录请求的 apk_sign 参数
GARUPA_CN_APK_SIGN=
# B 站游戏 SDK 版本号，作为 sdk_ver 参数
GARUPA_CN_SDK_VERSION=6.19.5
# Android 安装包版本代码，作为 SDK 登录请求的 version_code 参数
GARUPA_CN_VERSION_CODE=105
# 国服登录流程中每个 HTTP 请求的超时上限（毫秒），默认 30 秒
# 覆盖登录前游戏版本信息查询、SDK 获取公钥／帐号密码登录、游戏登录
# 每个请求独立计时，包含连接和响应体读取，排队等待另计
# 榜单请求沿用 DOWNLOADER_TIMEOUT_MS；不影响 iTunes 版本查询或通用下载器请求
GARUPA_CN_LOGIN_TIMEOUT_MS=30000
# 登录或认证请求失败后的冷却时间（毫秒），结束后的下一次请求触发重试
GARUPA_CN_LOGIN_RETRY_MS=30000
# ============================================================================
# MongoDB
# ============================================================================
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=garupa
# 主连接选择可用服务器的超时（毫秒）
MONGODB_SERVER_SELECTION_TIMEOUT_MS=60000
# 连接可用性探测超时（毫秒）
MONGODB_CONNECT_TIMEOUT_MS=5000
# 心跳检查间隔（毫秒）
MONGODB_RECONNECT_INTERVAL_MS=5000
# 数据库连接重试间隔（毫秒）
MONGODB_STARTUP_RETRY_INTERVAL_MS=5000
# ============================================================================
# 排名刷新
# ============================================================================
GARUPA_REFRESH_INTERVAL_SECONDS=60
GARUPA_REFRESH_AT_SECOND=0

# 歌曲主数据使用日服 suite/master，需配置 GARUPA_ENCRYPTION_KEYS 和
# GARUPA_ENCRYPTION_IVS 的第 1 项（日服）；歌曲接口无需 UID/UUID 和 MongoDB。
# 其他缓存、轮询和集合名称配置见 README.md 的「后端环境变量说明」。
