        "supertest": "^7.3.1",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.10",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    }
