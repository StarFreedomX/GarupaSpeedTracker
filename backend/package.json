    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "nodemon --ignore \"cache/**\" --ignore \"cache/**/*.tmp\" --ignore \"data/**\" --exec \"ts-node -r tsconfig-paths/register\" src/index.ts",
        "test": "jest --runInBand",
        "test:bestdori-chart-parser": "jest --runInBand src/parsers/BestdoriChartParser.test.ts",
        "build": "tsc && tsc-alias",
        "typecheck": "tsc --noEmit",
        "start": "node dist/index.js",
        "check": "biome check --write .",
        "format": "biome format --write .",
        "lint": "biome lint ./src"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "packageManager": "pnpm@10.28.2",
    "dependencies": {
