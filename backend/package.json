        "compare-versions": "^6.1.1",
        "dotenv": "^18.0.9",
        "fs-extra": "^11.4.1",
        "koa": "^3.2.1",
        "koa-parameter": "^3.0.1",
        "mongodb": "^7.8.0",
        "p-limit": "^3.1.0",
        "seek-bzip": "^2.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^30.0.0",
        "@types/koa": "^3.0.3",
        "@types/node": "^25.9.9",
        "@types/parameter": "^3.6.7",
        "@types/supertest": "^7.2.1",
